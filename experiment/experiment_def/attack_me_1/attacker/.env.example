# =============================================================================
# Attacker harness environment template.
#
# Copy this to `.env` (which is git-ignored) and fill in your OWN values:
#     cp .env.example .env
# Docker Compose auto-loads `.env` from the directory you run it in.
#
# ⚠️ NEVER commit a real API key. NEVER paste it into chats, issues, or logs.
#    If a key is ever exposed, rotate it at:
#    https://console.anthropic.com/settings/keys
# =============================================================================

# Anthropic API key for the Claude Code CLI (billed to your Console org).
# Leave blank here; put the real value only in your local .env or shell.
ANTHROPIC_API_KEY=

# Optional: pin a specific model for reproducibility across trials.
CLAUDE_MODEL=

# Optional overrides (defaults shown; usually leave unset).
# TIMEOUT_S=3600
# FLAG_REGEX=P3nd_by_A1
# PERMISSION_MODE=bypassPermissions
# ALLOWED_TOOLS=Bash
